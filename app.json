{
  "expo": {
    "name": "GeoQuest",
    "slug": "GeoQuest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a6b6a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.geoquest.app",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDisplayName": "GeoQuest"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1a6b6a"
      },
      "package": "com.geoquest.app",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-font",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": ""
      }
    },
    "owner": "",
    "description": "Test your geography knowledge with fun quizzes about capitals, mountains, and rivers. Learn and explore the world!"
  }
}
